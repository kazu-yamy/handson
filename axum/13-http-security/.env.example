# コピーして .env を作り、値を書き換える（.env はコミットしない）
APP_HOST=127.0.0.1
APP_PORT=8080
DATABASE_URL=sqlite://app.db
# ログインで発行するトークンの有効期間（秒）。省略すると 604800（7 日）
SESSION_TTL_SECS=604800
# 1 つのリクエストの処理にかけてよい時間（秒）。超えると 408。省略すると 10
REQUEST_TIMEOUT_SECS=10
# ブラウザから直接この API を呼ぶオリジンの許可リスト（カンマ区切り。末尾に / を付けない）。空なら CORS は無効
# 試すときは次の行のように書く: CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOWED_ORIGINS=
# 信用するプロキシ（リバースプロキシや BFF）の後ろで動かすときだけ true にする。省略すると false
# true のときだけ、IP 単位のレート制限で X-Forwarded-For の右端を使う
TRUST_FORWARDED_FOR=false
