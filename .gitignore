# OS
.DS_Store

# Node
node_modules/

# 各トラック直下（項目ブランチで作成する学習者向けプロジェクト）のビルド生成物
# document/ 配下には影響しない
**/node_modules/
**/.next/
**/out/
**/target/
**/.terraform/
*.tfstate
*.tfstate.*
**/.terraform.lock.hcl

# Android
**/build/
**/.gradle/
**/local.properties
**/*.iml

# iOS（Package.resolved は依存解決の再現性のため残す）
**/xcuserdata/
**/DerivedData/
**/*.xcworkspace/xcuserdata/
**/.build/

# 環境変数
**/.env*

# テスト・Storybook・TypeScript の生成物
**/coverage/
**/storybook-static/
**/*.tsbuildinfo
**/next-env.d.ts
**/debug-storybook.log
